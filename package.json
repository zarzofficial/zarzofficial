{
  "name": "zarzofficial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://zarzofficial.com",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/generate-responsive-images.mjs && vite build && node scripts/sync-static-build.cjs && tsx scripts/prerender.tsx",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs');['dist','docs'].forEach((dir)=>fs.rmSync(dir,{recursive:true,force:true}));\"",
    "images:responsive": "node scripts/generate-responsive-images.mjs",
    "lint": "tsc --noEmit",
    "predeploy": "npm run build",
    "deploy": "node -e \"console.log('GitHub Pages publishes from main/docs. Push main after build.')\""
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.12.0",
    "framer-motion": "^12.38.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "shadcn": "^4.6.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.2"
  }
}
