rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && (request.auth.token.email == "medozxc7@gmail.com" || request.auth.token.email == "ezh37156@gmail.com");
    }

    function currentUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserRecord().data.role == "admin";
    }

    function isAdmin() {
      return isBootstrapAdmin() || hasAdminRole();
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function optionalStringWithin(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function validUser(data, userId) {
      return data.keys().hasAll([
        'uid',
        'name',
        'email',
        'phone',
        'photoURL',
        'emailVerified',
        'createdAt',
        'role'
      ]) &&
      data.keys().hasOnly([
        'uid',
        'name',
        'email',
        'phone',
        'photoURL',
        'emailVerified',
        'createdAt',
        'role'
      ]) &&
      data.uid is string &&
      data.uid == userId &&
      data.uid.size() > 0 &&
      data.uid.size() <= 128 &&
      optionalStringWithin(data.name, 100) &&
      optionalStringWithin(data.email, 200) &&
      optionalStringWithin(data.phone, 40) &&
      optionalStringWithin(data.photoURL, 500) &&
      data.emailVerified is bool &&
      optionalStringWithin(data.role, 40) &&
      data.createdAt is timestamp;
    }

    function orderOwnershipFieldsOnlyChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'userId',
        'userEmail',
        'ownerType',
        'guestTransferKey',
        'transferredAt',
        'transferredFromGuestId'
      ]);
    }

    function ownOrderOwnershipUpdate(userId) {
      return isOwnUser(userId)
        && resource.data.userId == userId
        && request.resource.data.userId == resource.data.userId
        && orderOwnershipFieldsOnlyChanged();
    }

    match /users/{userId} {
      allow get: if isAdmin() || isOwnUser(userId);
      allow list: if isAdmin();
      allow create: if validUser(request.resource.data, userId) &&
        (isBootstrapAdmin() || (isOwnUser(userId) && request.resource.data.role == null));
      allow update: if validUser(request.resource.data, userId) &&
        (isAdmin() || (
          isOwnUser(userId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.role == resource.data.role
        ));
      allow delete: if isAdmin();

      match /orders/{orderId} {
        allow read: if isAdmin() || isOwnUser(userId);
        allow create: if isOwnUser(userId) && request.resource.data.userId == userId;
        allow update: if isAdmin() || ownOrderOwnershipUpdate(userId);
        allow delete: if isAdmin() || isOwnUser(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
