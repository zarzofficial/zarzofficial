rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && (request.auth.token.email == "medozxc7@gmail.com" || request.auth.token.email == "ezh37156@gmail.com");
    }

    function currentUserRecord() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && currentUserRecord().data.role == "admin";
    }

    function isAdmin() {
      return isBootstrapAdmin() || hasAdminRole();
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function writesOwnUserRecord(userId) {
      return isOwnUser(userId)
        && request.resource.data.uid == userId;
    }

    match /users/{userId} {
      allow get: if isAdmin() || isOwnUser(userId);
      allow list: if isAdmin();
      allow create: if isBootstrapAdmin() || (writesOwnUserRecord(userId) && request.resource.data.role == null);
      allow update: if isAdmin() || (
        writesOwnUserRecord(userId)
        && resource.data.uid == userId
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin();

      match /orders/{orderId} {
        allow read: if isAdmin() || isOwnUser(userId);
        allow create: if isOwnUser(userId) && request.resource.data.userId == userId;
        allow update: if isAdmin();
        allow delete: if isAdmin() || isOwnUser(userId);
      }
    }

    match /{path=**}/orders/{orderId} {
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
